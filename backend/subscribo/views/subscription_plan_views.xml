<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscribo_plan_list" model="ir.ui.view">
        <field name="name">subscribo.plan.list</field>
        <field name="model">subscribo.plan</field>
        <field name="arch" type="xml">
            <list string="Subscription Plans" decoration-muted="not active">
                <field name="name"/>
                <field name="billing_period"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="minimum_quantity"/>
                <field name="available_from" optional="hide"/>
                <field name="available_until" optional="hide"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_subscribo_plan_form" model="ir.ui.view">
        <field name="name">subscribo.plan.form</field>
        <field name="model">subscribo.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Business Monthly"/></h1>
                    </div>
                    <group>
                        <group string="Pricing and Billing">
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="billing_period"/>
                            <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id"/>
                            <field name="service_product_id" options="{'no_create': True}"/>
                            <field name="minimum_quantity"/>
                        </group>
                        <group string="Availability">
                            <field name="available_from"/>
                            <field name="available_until"/>
                        </group>
                    </group>
                    <group string="Subscription Policies">
                        <field name="auto_close_at_end"/>
                        <field name="allow_early_close"/>
                        <field name="allow_pause"/>
                        <field name="allow_renewal"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscribo_plan_search" model="ir.ui.view">
        <field name="name">subscribo.plan.search</field>
        <field name="model">subscribo.plan</field>
        <field name="arch" type="xml">
            <search string="Subscription Plans">
                <field name="name"/>
                <field name="billing_period"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_period" string="Billing Period" context="{'group_by': 'billing_period'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscribo_plans" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscribo.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subscribo_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a subscription plan</p>
            <p>Set its price, billing period, availability, and lifecycle policies.</p>
        </field>
    </record>
</odoo>
