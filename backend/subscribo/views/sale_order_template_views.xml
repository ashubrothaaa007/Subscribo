<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_template_form_subscribo" model="ir.ui.view">
        <field name="name">sale.order.template.form.subscribo</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info']" position="inside">
                <field name="subscribo_plan_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
