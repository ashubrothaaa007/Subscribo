<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscribo_renewal_wizard_form" model="ir.ui.view">
        <field name="name">subscribo.renewal.wizard.form</field>
        <field name="model">subscribo.renewal.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Subscription">
                <group>
                    <field name="subscription_id"/>
                    <field name="start_date"/>
                    <field name="expiry_date"/>
                </group>
                <footer>
                    <button name="action_create_renewal" type="object" string="Create Renewal Quotation" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subscribo_renewal_wizard" model="ir.actions.act_window">
        <field name="name">Renew Subscription</field>
        <field name="res_model">subscribo.renewal.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_subscribo_renewal_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>

